{
  "parametros": {
    "titulo": "Formulario Genérico",
     "CssDefault": "formulariodinamicostyle12.css",
    "tituloimagen": "https://cdn.pixabay.com/photo/2017/05/31/16/39/windows-2360920_1280.png",
    "comentario": "Observa cómo cada etiqueta y tipo de campo se comporta.",
    "pie": "Gracias por usar nuestro sistema.",
    "fecha_creacion": "2024-06-20",
    "cantidadMaximaAdjuntos": 2,
    "limpiar": true,
    "destinatario": "fernandorivassoto@gmail.com",
    "remitente": "gestion@saludenterreno.cl",
    "subject": "Nuevo mensaje desde el formulario de contacto",
    "estilo": "padding:20px; background:#e8f0fe;",
    "mailDe": "Intranet@SaludEnterreno.cl",
    "mailPara": "fernandorivassoto@gmail.com",
    "mailCc": "copia@example.com",
    "mailCco": "copiaoculta@example.com",
    "tipoformatoenvio": "htmlc,pdf,html,xls,json,cvs,xlsx,doc,xml",
    "mensajes": {
      "exito": "¡Formulario enviado correctamente!",
      "error": "Ocurrió un error al procesar el formulario.",
      "advertencia": "Por favor, revisa los campos resaltados."
    },
    "validaciones": {
      "email": {
        "regex": "^[\\w\\.-]+@[\\w\\.-]+\\.\\w{2,}$",
        "mensaje": "El correo no es válido."
      },
      "telefono": {
        "regex": "^\\+56\\d{9}$",
        "mensaje": "El teléfono debe tener formato +569XXXXXXXX."
      }
    },
    "botones": [
      { "texto": "Guardar", "accion": "submit", "clase": "btn-success" },
      { "texto": "Limpiar", "accion": "reset", "clase": "btn-secondary" }
    ],
    "post_envio": {
      "redireccion": "",
      "mostrar_resumen": true,
      "limpiar_sesion": true
    },
    "adjuntos": {
      "tipos_permitidos": [
        "image/jpeg", "image/png", "image/gif", "application/pdf",
        "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "text/plain", "application/zip", "application/x-zip-compressed",
        "application/vnd.ms-powerpoint", "application/octet-stream"
      ],
      "tamano_maximo_mb": 5
    },
    "notificaciones": {
      "enviar_correo": true,
      "guardar_bd": false,
      "mostrar_modal": true
    }
  },
  "preformato": [
    {
      "titulo": "Boleta de Venta",
      "archivo_origen": "boleta.xls",
      "formato_salida": "pdf",
      "nombre_salida": "boleta_final.pdf",
      "adjuntar_al_correo": true,
      "verpreformato": true,
      "reemplazos": {
        "{{cliente}}": "Juan Pérez",
        "{{label:Total}}": "Total a pagar",
        "{{fecha}}": "2025-07-14"
      }
    },
    {
      "titulo": "Resumen de Compra",
      "archivo_origen": "resumen.docx",
      "formato_salida": "docx",
      "nombre_salida": "resumen_final.docx",
      "adjuntar_al_correo": false,
      "verpreformato": true,
      "reemplazos": {
        "{{cliente}}": "Juan Pérez",
        "{{label:Resumen}}": "Resumen de la compra"
      }
    }
  ],
  "layout": {
    "main": {
      "type": "generic",
      "rows": [
        { "columns": [ { "width": 12, "fieldset": "Datos Personales (Demostración de Posiciones)" } ] },
        { "columns": [ { "width": 12, "fieldset": "Preferencias y Otros" } ] },
        { "columns": [ { "width": 12, "fieldset": "Detalle de Productos" } ] }
      ]
    }
  },
  "fieldsets": [
    {
      "legend": "Datos Personales (Demostración de Posiciones)",
      "style": "border:1px solid #007BFF; padding:10px; background:#f9f9f9;",
      "fields": [
        { "name": "nombre", "label": "Nombre (top-left)", "type": "text", "placeholder": "Ingrese su nombre completo", "required": true, "labelPosition": "top-left" },
        
      
        { "name": "ComId", "label": "Código", "type": "text", "placeholder": "Ingrese código", "labelPosition": "left" },
           
        { 
          "name": "descripcion_comuna", 
          "label": "Comuna", 
          "type": "text", 
          "placeholder": "Descripción de la comuna aparecerá aquí", 
          "labelPosition": "left", 
          "readonly": true, 
          "data-formula": { 
            "type": "lookup", 
            "source": { "table": "Comuna", "field": "ComDes" }, 
            "where": "ComId = {ComId}" 
          }
        },

        { "name": "total", "label": "Total  ", "type": "number", "placeholder": "0", "readonly": true, "labelPosition": "top", "data-formula": "10 + 10 * edad" },
        { "name": "email", "label": "Correo (top - por defecto)", "type": "email", "placeholder": "ejemplo@correo.com", "required": true, "labelPosition": "top" },
        { "name": "telefono", "label": "Teléfono (top-center)", "type": "tel", "placeholder": "Ej: +56912345678", "labelPosition": "top-center" },
        { "name": "fecha_nacimiento", "label": "Nacimiento (top-right)", "type": "date", "labelPosition": "top-right" },
        { "name": "hora_contacto", "label": "Hora (bottom)", "type": "time", "labelPosition": "bottom" },
        { "name": "descripcion", "label": "Descripción (bottom-left)", "type": "textarea", "placeholder": "Añada una breve descripción...", "rows": 2, "labelPosition": "bottom-left" },
        { "name": "archivos_adjuntos", "label": "Adjuntos (bottom-center)", "type": "file", "multiple": true, "labelPosition": "bottom-center" },
        { "name": "edad", "label": "Edad (bottom-right)", "type": "number", "placeholder": "Ingrese su edad", "labelPosition": "bottom-right" },
        { "name": "password", "label": "Contraseña (left)", "type": "password", "placeholder": "Ingrese una contraseña segura", "required": true, "labelPosition": "left" }
      ]
    },
    {
      "legend": "Preferencias y Otros",

      
      "style": "border:1px solid #28a745; padding:10px; background:#f5fff5;",
      "fields": [
        { 
          "name": "genero", 
          "label": "Género (top-center)", 
          "type": "radio", 
          "required": true, 
          "labelPosition": "top-center", 
          "layout": "horizontal", 
          "options": [ 
            { "value": "masculino", "label": "Masculino" }, 
            { "value": "femenino", "label": "Femenino" } 
          ] 
        },
        { "name": "cantidadhijos", "label": "Cantidadhijos", "type": "number", "min": 1, "placeholder": "1" },
        { "name": "Atrab", "label": "Años.", "type": "number", "step": "0.01", "placeholder": "10000" },
        { 
          "name": "intereses", 
          "label": "Intereses (top-left)", 
          "type": "checkbox", 
          "labelPosition": "top-left", 
          "options": [ 
            { "value": "deportes", "label": "Deportes" }, 
            { "value": "musica", "label": "Música" }, 
            { "value": "tecnologia", "label": "Tecnología" } 
          ] 
        },
        { 
          "name": "acepta_terminos", 
          "label": "Acepto los términos (right)", 
          "type": "checkbox", 
          "required": true, 
          "labelPosition": "right", 
          "options": [ 
            { "value": "si", "label": "" } 
          ] 
        },
        { "name": "rango_satisfaccion", "label": "Satisfacción (top-right)", "type": "range", "min": 1, "max": 10, "labelPosition": "top-right" },
        { "name": "oculto", "type": "hidden", "value": "valor_oculto" },
        { "name": "ciudad_2", "label": "Ciudad (left)", "type": "selectdata", "labelPosition": "left", "data": { "tabla": "Comuna", "campo": "ComDes", "filtro": "1=1" } }
      ]
    },
    {
      "legend": "Detalle de Productos",
      "style": "border:1px solid #dc3545; padding:10px; background:#fff5f5;",
      "fields": [
        {
          "name": "items",
          "label": "Listado de Items",
          "type": "datatable",
          "labelPosition": "top",
          "columns": [
            { "name": "id_producto", "label": "ID Producto", "type": "text", "placeholder": "PROD-XXX" },
            { "name": "descripcion", "label": "Descripción", "type": "text", "placeholder": "Nombre del producto" },
            { "name": "cantidad", "label": "Cantidad", "type": "number", "placeholder": "0" },
            { 
              "name": "precio_unitario", 
              "label": "Precio Unit.", 
              "type": "number", 
              "placeholder": "0.00" 
            },
            { 
              "name": "subtotal", 
              "label": "Subtotal", 
              "type": "number", 
              "placeholder": "0.00", 
              "readonly": true, 
              "data-formula": "cantidad * precio_unitario * total" 
            }
          ],
          "value": [
            { "id_producto": "PROD-001", "descripcion": "Mouse Inalámbrico", "cantidad": 2, "precio_unitario": 15000 },
            { "id_producto": "PROD-002", "descripcion": "Teclado Mecánico", "cantidad": 1, "precio_unitario": 55000 }
          ]
        }
      ]
    }
  ]
}
{
  "parametros": {
    "titulo": "Formulario Genérico A TRATAR",
    "CssDefault": "formulariodinamico-base.css" ,
    "tituloimagen": "https://cdn.pixabay.com/photo/2017/05/31/16/39/windows-2360920_1280.png",
    "comentario": "Observa cómo cada etiqueta y tipo de campo se comporta.",
    "pie": "Gracias por usar nuestro sistema.",
    "fecha_creacion": "2024-06-20",
    "cantidadMaximaAdjuntos": 2,
    "limpiar": true,
    "destinatario": "fernandorivassoto@gmail.com",
    "remitente": "gestion@saludenterreno.cl",
    "subject": "Nuevo mensaje desde el formulario de contacto",
    "estilo": "padding:20px; background:#e8f0fe;",
    "mailDe": "Intranet@SaludEnterreno.cl",
    "mailPara": "fernandorivassoto@gmail.com",
    "mailCc": "copia@example.com",
    "mailCco": "copiaoculta@example.com",
    "tipoformatoenvio": "html,pdf,xls,json,csv,xlsx,doc,xml",
    "mensajes": {
      "exito": "¡Formulario enviado correctamente!",
      "error": "Ocurrió un error al procesar el formulario.",
      "advertencia": "Por favor, revisa los campos resaltados."
    },
    "validaciones": {
      "email": {
        "regex": "^[\\w\\.-]+@[\\w\\.-]+\\.\\w{2,}$",
        "mensaje": "El correo no es válido."
      },
      "telefono": {
        "regex": "^\\+56\\d{9}$",
        "mensaje": "El teléfono debe tener formato +569XXXXXXXX."
      }
    },
    "botones": [
      { "texto": "Guardar", "accion": "submit", "clase": "btn-success" },
      { "texto": "Limpiar", "accion": "reset", "clase": "btn-secondary" }
    ],
    "post_envio": {
      "redireccion": "",
      "mostrar_resumen": true,
      "limpiar_sesion": true
    },
    "adjuntos": {
      "tipos_permitidos": [
        "image/jpeg", "image/png", "image/gif", "application/pdf",
        "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "text/plain", "application/zip", "application/x-zip-compressed",
        "application/vnd.ms-powerpoint", "application/octet-stream"
      ],
      "tamano_maximo_mb": 5
    },
    "notificaciones": {
      "enviar_correo": true,
      "guardar_bd": false,
      "mostrar_modal": true
    }
  },
  "fieldsets": {
  "datos_personales": {
    "embevido_demo": {
      "titulo": "Demo Embebido",
      "campos": [
        {
          "nombre": "contenido_embebido",
          "tipo": "embevido",
          "etiqueta": "Contenido Embebido",
          "url_embebido": "https://mail.google.com/mail/u/0/#inbox",
          "parametros_embebido": { "usuario": "123", "token": "abc" },
          "alto": "400px",
          "ancho": "100%",
          "mostrar_borde": true,
          "permitir_fullscreen": true
        }
      ]
    },
      "titulo": "Datos Personales.......................",
      "campos": [
        { "nombre": "nombre_completo", "etiqueta": "Nombre Completo (text)", "tipo": "text", "placeholder": "Ingrese su nombre", "atributos": { "required": true } },
        { "nombre": "email", "etiqueta": "Correo Electrónico (email)", "tipo": "email", "placeholder": "ejemplo@dominio.com" },
        { "nombre": "clave_acceso", "etiqueta": "Contraseña (password)", "tipo": "password" }
      ]
    },
    "datos_contacto": {
      "titulo": "Información de Contacto",
      "campos": [
        { "nombre": "telefono", "etiqueta": "Teléfono (text)", "tipo": "text", "placeholder": "+56 9 1234 5678" },
        { "nombre": "direccion", "etiqueta": "Dirección (textarea)", "tipo": "textarea", "placeholder": "Calle, número, comuna, ciudad" }
      ]
    },
    "campos_variados": {
      "titulo": "Tipos de Campos Variados",
      "campos": [
        { "nombre": "fecha_nacimiento", "etiqueta": "Fecha de Nacimiento (date)", "tipo": "date" },
        { "nombre": "edad", "etiqueta": "Edad (number)", "tipo": "number", "placeholder": "30" },
        { "nombre": "genero", "etiqueta": "Género (radio)", "tipo": "radio", "opciones": { "masculino": "Masculino", "femenino": "Femenino", "otro": "Otro" } },

        { "nombre": "pais_db", "etiqueta": "País (cargado desde BD)..", "tipo": "select", "data-source": {
    "tabla": "Pais",
    "campo_valor": "PaiId",
    "campo_etiqueta": "PaiDes",
    "order": "PaiDes ASC"
  } },
        { "nombre": "ciudad_db", "etiqueta": "Ciudad (depende del país..)", "tipo": "select", "data-source": {
    "tabla": "Ciudad",
    "campo_valor": "CiuId",
    "campo_etiqueta": "CiuDes",
    "filtro": "PaiId={pais_db}",
    "order": "CiuDes ASC"
  } },



 { "nombre": "comuna_Id", "etiqueta": "Comuna (depende del ciudad)", "tipo": "select", "data-source": {
    "tabla": "Comuna",
    "campo_valor": "ComId",
    "campo_etiqueta": "ComDes",
    "filtro": "CiuId={ciudad_db}",
    "order": "ComDes ASC"
  } },


        
        { "nombre": "habilidades", "etiqueta": "Habilidades (select2 múltiple)", "tipo": "select", "atributos": { "multiple": "multiple" }, "opciones": { "php": "PHP", "js": "JavaScript", "css": "CSS", "sql": "SQL", "react": "React" } },
        { "nombre": "acepta_notificaciones", "etiqueta": "Acepta recibir notificaciones (checkbox)", "tipo": "checkbox", "opciones": { "si": "" } },
        { "nombre": "id_oculto", "tipo": "hidden", "valor_predeterminado": "ABC-123" },
        { "nombre": "cv_adjunto", "etiqueta": "Adjuntar CV (file)", "tipo": "file" }
      ]
    },
    "productos_factura": {
      "titulo": "Detalle de Productos (Datatable con Fórmula)",
      "campos": [
        {
          "nombre": "detalle_productos",
          "tipo": "datatable",
          "etiqueta": "Producto",
          "busqueda_simple": "enable",
          "filtro_avanzado": "enable",
          "sumar_columnas": ["precio", "cantidad"],
          "columnas": [
            { "nombre": "producto", "etiqueta": "Producto", "tipo": "text" },
            { "nombre": "precio", "etiqueta": "Precio", "tipo": "number" },
            { "nombre": "cantidad", "etiqueta": "Cantidad", "tipo": "number" },
            { "nombre": "total_linea", "etiqueta": "Total", "tipo": "number" }
          ],
          "dataSource": {
            "tabla": ""   
          }
        }
      ]
    },
    "resumen_factura": {
      "titulo": "Resumen y Totales",
      "campos": [
        {
          "nombre": "total_factura",
          "etiqueta": "Total Factura (Fórmula)",
          "tipo": "number",
          "atributos": { "readonly": true, "style": "font-weight: bold; font-size: 1.2em;" },
          "data-formula": "SUM(detalle_productos.total_linea)"
        }
      ]
    },
    "header_info": {
      "titulo": "Información General del Formulario",
      "campos": [
        { "nombre": "tipo_solicitud", "etiqueta": "Tipo de Solicitud", "tipo": "text", "valor_predeterminado": "Postulación Completa", "atributos": { "readonly": true } }
      ]
    },
    "footer_legal": {
      "titulo": "Términos y Condiciones",
      "campos": [
        { "nombre": "aceptar_terminos", "etiqueta": "Acepto los términos y condiciones", "tipo": "checkbox", "opciones": { "si": "" } }
      ]
    },
    "todos_los_controles": {
      "titulo": "Todos los Tipos de Control",
      "layout": [
        { "row": [
          { "col": 6, "campo": "campo_texto" },
          { "col": 6, "campo": "campo_textarea" }
        ] },
        { "row": [
          { "col": 4, "campo": "campo_numero" },
          { "col": 4, "campo": "campo_email" },
          { "col": 4, "campo": "campo_password" }
        ] },
        { "row": [
          { "col": 6, "campo": "campo_select" },
          { "col": 6, "campo": "campo_selectdata" }
        ] },
        { "row": [
          { "col": 6, "campo": "campo_radio" },
          { "col": 6, "campo": "campo_checkbox" }
        ] },
        { "row": [
          { "col": 6, "campo": "campo_file" },
          { "col": 6, "campo": "campo_date" }
        ] },
        { "row": [
          { "col": 12, "campo": "campo_select_multiple" }
        ] },
        { "row": [
          { "col": 12, "campo": "campo_datatable" }
        ] }
      ],
      "campos": [
        { "nombre": "campo_texto", "etiqueta": "Campo de Texto", "tipo": "text", "placeholder": "Texto simple" },
        { "nombre": "campo_textarea", "etiqueta": "Área de Texto", "tipo": "textarea", "placeholder": "Texto largo" },
        { "nombre": "campo_numero", "etiqueta": "Número", "tipo": "number", "placeholder": "123" },
        { "nombre": "campo_email", "etiqueta": "Correo Electrónico", "tipo": "email", "placeholder": "correo@dominio.com" },
        { "nombre": "campo_password", "etiqueta": "Contraseña", "tipo": "password" },
        { "nombre": "campo_select", "etiqueta": "Select (Opciones Fijas)", "tipo": "select", "opciones": { "op1": "Opción 1", "op2": "Opción 2", "op3": "Opción 3" } },
         { "nombre": "campo_radio", "etiqueta": "Radio", "tipo": "radio", "opciones": { "a": "Opción A", "b": "Opción B" } },
        { "nombre": "campo_checkbox", "etiqueta": "Checkbox", "tipo": "checkbox", "opciones": { "x": "Marca X", "y": "Marca Y" } },
        { "nombre": "campo_file", "etiqueta": "Archivo", "tipo": "file" },
        { "nombre": "campo_date", "etiqueta": "Fecha", "tipo": "date" },
        { "nombre": "campo_hidden", "tipo": "hidden", "valor_predeterminado": "oculto123" },
        { "nombre": "campo_select_multiple", "etiqueta": "Select Múltiple", "tipo": "select", "atributos": { "multiple": "multiple" }, "opciones": { "uno": "Uno", "dos": "Dos", "tres": "Tres" } },
        { "nombre": "campo_datatable", "etiqueta": "Datatable (Mixto)", "tipo": "datatable",
          "busqueda_simple": "enable",
          "filtro_avanzado": "enable",
          "sumar_columnas": ["col_numero"],
          "columnas": [
            { "nombre": "col_texto", "etiqueta": "Columna Texto", "tipo": "text" },
            { "nombre": "col_numero", "etiqueta": "Columna Número", "tipo": "number" },
            { "nombre": "col_select", "etiqueta": "Columna Select", "tipo": "select", "opciones": { "a": "A", "b": "B" } },
            { "nombre": "col_fecha", "etiqueta": "Columna Fecha", "tipo": "date" },
            { "nombre": "col_checkbox", "etiqueta": "Columna Checkbox", "tipo": "checkbox", "opciones": { "si": "Sí", "no": "No" } }
          ],
          "dataSource": { "tabla": "" }
        }
      ]
    },
    "grupo_grilla_ejemplo": {
      "titulo": "Grilla de Ejemplo en Fieldset",
      "campos": [
        {
          "nombre": "grilla_ejemplo",
          "tipo": "datatable",
          "etiqueta": "Grilla de Ejemplo",
          "busqueda_simple": "enable",
          "filtro_avanzado": "enable",
          "sumar_columnas": ["col2"],
          "dataSource": { "tabla": "" },
          "columnas": [
            { "nombre": "col1", "etiqueta": "Columna 1", "tipo": "text" },
            { "nombre": "col2", "etiqueta": "Columna 2", "tipo": "number" },
            { "nombre": "col3", "etiqueta": "Columna 3", "tipo": "select", "opciones": { "a": "A", "b": "B" } }
          ]
        }
      ]
    },
    "header": {
      "titulo": "Cabecera",
      "campos": [
        { "nombre": "fecha", "tipo": "date", "etiqueta": "Fecha", "valor_predeterminado": "" },
        { "nombre": "documento", "tipo": "text", "etiqueta": "Documento", "placeholder": "N° doc." }
      ]
    },
    "principal": {
      "titulo": "Datos principales",
      "campos": [
        { "nombre": "cliente", "tipo": "text", "etiqueta": "Cliente" },
          { "nombre": "cliente1", "tipo": "text", "etiqueta": "Grupo" },
        { "nombre": "importe", "tipo": "number", "etiqueta": "Importe" }


      ]
    },
    "footer": {
      "titulo": "Pie",
      "campos": [
        { "nombre": "observaciones", "tipo": "textarea", "etiqueta": "Observaciones" }
      ]
    },
    "contenido_embebido": {
      "nombre": "contenido_embebido",
      "tipo": "embevido",
      "etiqueta": "Contenido Embebido",
      "url_embebido": "https://www.ejemplo.com/archivo.html",
      "parametros_embebido": { "usuario": "123", "token": "abc" },
      "alto": "400px",
      "ancho": "100%",
      "mostrar_borde": true,
      "permitir_fullscreen": true
    }
  },
  "layout": {
    "header": {
      "type": "header",
      "rows": [
        {
          "columns": [
            { "width": 6, "fieldset": "header" },
            { "width": 6, "fieldset": "header_info" }
          ]
        }
      ]
    },
    "main": {
      "type": "tabs",
      "tabs": [
        {
          "title": "General",
          "rows": [
            { "columns": [ { "width": 12, "fieldset": "principal" } ] }
          ]
        },
        {
          "title": "Datos Personales",
          "rows": [
            {
              "columns": [
                { "width": 6, "fieldset": "datos_personales" },
                { "width": 6, "fieldset": "datos_contacto" }
              ]
            }
          ]
        },
        {
          "title": "Embebido",
          "rows": [
            { "columns": [ { "width": 12, "fieldset": "embevido_demo" } ] }
          ]
        },
        {
          "title": "Contacto",
          "rows": [
            { "columns": [ { "width": 12, "fieldset": "datos_contacto" } ] }
          ]
        },
        {
          "title": "Campos Variados",
          "rows": [
            { "columns": [ { "width": 12, "fieldset": "campos_variados" } ] }
          ]
        },
        {
          "title": "Productos",
          "rows": [
            { "columns": [ { "width": 12, "fieldset": "productos_factura" } ] }
          ]
        },
        {
          "title": "Resumen",
          "rows": [
            { "columns": [ { "width": 12, "fieldset": "resumen_factura" } ] }
          ]
        },
        {
          "title": "Todos los Controles",
          "rows": [
            { "columns": [ { "width": 12, "fieldset": "todos_los_controles" } ] }
          ]
        },
        {
          "title": "Grilla Ejemplo1",



          "rows": [
            { "columns": [ { "width": 12, "fieldset": "grupo_grilla_ejemplo" } ] }



          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "rows": [
        {
          "columns": [
            { "width": 3, "fieldset": "footer" },
           
            { "width": 3, "fieldset": "footer_legal" }
          ]
        }
      ]
    }
  }
}
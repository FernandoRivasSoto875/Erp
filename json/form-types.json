{
  "field_types": {
    "text":         { "html": "input",   "subtype": "text" },
    "textarea":     { "html": "textarea" },
    "number":       { "html": "input",   "subtype": "number" },
    "integer":      { "html": "input",   "subtype": "number", "step": 1 },
    "decimal":      { "html": "input",   "subtype": "number", "step": "0.01" },
    "currency":     { "html": "input",   "subtype": "number", "step": "0.01", "format": "currency" },
    "percent":      { "html": "input",   "subtype": "number", "step": "0.01", "format": "percent" },
    "date":         { "html": "input",   "subtype": "date" },
    "datetime":     { "html": "input",   "subtype": "datetime-local" },
    "time":         { "html": "input",   "subtype": "time" },
    "email":        { "html": "input",   "subtype": "email" },
    "tel":          { "html": "input",   "subtype": "tel" },
    "url":          { "html": "input",   "subtype": "url" },
    "password":     { "html": "input",   "subtype": "password" },
    "checkbox":     { "html": "input",   "subtype": "checkbox" },
    "switch":       { "html": "input",   "subtype": "checkbox" },
    "radio":        { "html": "input",   "subtype": "radio" },
    "range":        { "html": "input",   "subtype": "range" },
    "color":        { "html": "input",   "subtype": "color" },
    "hidden":       { "html": "input",   "subtype": "hidden" },

    "select":       { "html": "select",  "multiple": false },
    "multiselect":  { "html": "select",  "multiple": true },

    "select2":            { "html": "select", "component": "select2", "multiple": false },
    "select2_multiselect":{ "html": "select", "component": "select2", "multiple": true },
    "select_remote":      { "html": "select", "component": "select2", "remote": true, "multiple": false },
    "select2_remote":     { "html": "select", "component": "select2", "remote": true, "multiple": false },

    "autocomplete":       { "html": "custom", "component": "autocomplete" },
    "autocomplete_remote":{ "html": "custom", "component": "autocomplete", "remote": true },
    "lookup":       { "html": "custom", "component": "lookup" },
    "chips":        { "html": "custom", "component": "chips" },
    "tags":         { "html": "custom", "component": "chips" },

    "file":         { "html": "input",   "subtype": "file" },
    "multifile":    { "html": "input",   "subtype": "file", "multiple": true },
    "image":        { "html": "input",   "subtype": "file", "accept": "image/*" },

    "html":         { "html": "custom", "component": "html" },
    "markdown":     { "html": "custom", "component": "markdown" },
    "editor":       { "html": "custom", "component": "editor", "variant": "quill" },
    "code":         { "html": "custom", "component": "code", "language": "javascript" },
    "jsoneditor":   { "html": "custom", "component": "jsoneditor" },

    "table":        { "html": "custom", "component": "table" },
    "datatable":    { "html": "custom", "component": "datatable", "columns": [], "dataSource": "", "serverSide": false },

    "grid":         { "html": "custom", "component": "grid" },
    "repeater":     { "html": "custom", "component": "repeater", "itemSchema": {} },

    "map":          { "html": "custom", "component": "map" },
    "geolocation":  { "html": "custom", "component": "geolocation" },
    "signature":    { "html": "custom", "component": "signature" },
    "qrcode":       { "html": "custom", "component": "qrcode" },
    "barcode":      { "html": "custom", "component": "barcode" },
    "rating":       { "html": "custom", "component": "rating", "max": 5 },
    "captcha":      { "html": "custom", "component": "captcha" },

    "tree":         { "html": "custom", "component": "tree" },
    "treeselect":   { "html": "custom", "component": "treeselect" },

    "badge":        { "html": "custom", "component": "badge" },
    "button":       { "html": "button", "variant": "primary" }
  },
  "fieldset_types": {
    "group":      { "layout": "stack" },
    "card":       { "layout": "stack" },
    "panel":      { "layout": "stack" },
    "section":    { "layout": "stack" },
    "row":        { "layout": "row" },
    "column":     { "layout": "column" },
    "tabs":       { "layout": "tabs" },
    "accordion":  { "layout": "accordion" },
    "stepper":    { "layout": "steps" },
    "wizard":     { "layout": "steps" },
    "divider":    { "layout": "separator" }
  }
}
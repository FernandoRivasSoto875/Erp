{
  "parametros": {
    "titulo": "Formulario Genérico 2 - Layout Avanzado",
    "CssDefault": "formulariodinamico-neumorphism.css",
    "comentario": "Demostración de layout dinámico con cabecera y pestañas.",
    "pie": "Gracias por usar nuestro sistema.",
    "fecha_creacion": "2024-08-06",
    "cantidadMaximaAdjuntos": 5,
    "limpiar": true,
    "destinatario": "fernandorivassoto@gmail.com",
    "remitente": "gestion@saludenterreno.cl",
    "subject": "Nuevo mensaje desde el formulario de contacto",
    "estilo": "padding:20px; background:#e8f0fe;",
    "mailDe": "Intranet@SaludEnterreno.cl",
    "mailPara": "fernandorivassoto@gmail.com",
    "mailCc": "copia@example.com",
    "mailCco": "copiaoculta@example.com",
    "tipoformatoenvio": "htmlc,pdf,html,xls,json,cvs,xlsx,doc,xml",
    "mensajes": {
      "exito": "¡Formulario enviado correctamente!",
      "error": "Ocurrió un error al procesar el formulario.",
      "advertencia": "Por favor, revisa los campos resaltados."
    },
    "validaciones": {
      "email": {
        "regex": "^[\\w\\.-]+@[\\w\\.-]+\\.\\w{2,}$",
        "mensaje": "El correo no es válido."
      },
      "telefono": {
        "regex": "^\\+56\\d{9}$",
        "mensaje": "El teléfono debe tener formato +569XXXXXXXX."
      }
    },
    "botones": [
      { "texto": "Guardar", "accion": "submit", "clase": "btn-success" },
      { "texto": "Limpiar", "accion": "reset", "clase": "btn-secondary" }
    ],
    "post_envio": {
      "redireccion": "",
      "mostrar_resumen": true,
      "limpiar_sesion": true
    },
    "adjuntos": {
      "tipos_permitidos": ["image/jpeg", "image/png", "application/pdf"],
      "tamano_maximo_mb": 5
    },
    "notificaciones": {
      "enviar_correo": true,
      "guardar_bd": false,
      "mostrar_modal": true
    }
  },
  "layout": {
    "header": {
      "type": "header",
      "rows": [
        { "cols": [
            { "size": 12, "fieldsets": ["datos_personales"] }
        ]}
      ]
    },
    "main": {
      "type": "tabs",
      "tabs": [
        {
          "title": "Contacto y Productos",
          "rows": [
            { "cols": [ 
                { "size": 6, "fieldsets": ["datos_contacto"] },
                { "size": 6, "fieldsets": ["detalle_productos"] }
            ] }
          ]
        },
        {
          "title": "Galería de Controles",
          "rows": [
            { "cols": [ { "size": 12, "fieldsets": ["todos_los_controles"] } ] }
          ]
        },
        {
          "title": "Información Adicional",
          "rows": [
            { "cols": [ { "size": 12, "fieldsets": ["informacion_adicional"] } ] }
          ]
        },
        {
          "title": "Resumen y Envío",
          "rows": [
            { "cols": [ { "size": 12, "fieldsets": ["resumen_envio"] } ] }
          ]
        }
      ]
    }
  },
  "fieldsets": [
    {
      "name": "datos_personales",
      "legend": "Datos Personales (Cabecera)",
      "style": "border:1px solid #007BFF; padding:10px; background:#f9f9f9;",
      "fields": [
        { "name": "nombre", "label": "Nombre", "type": "text", "placeholder": "Ingrese su nombre completo", "required": true },
        { "name": "email", "label": "Correo", "type": "email", "placeholder": "ejemplo@correo.com", "required": true }
      ]
    },
    {
      "name": "datos_contacto",
      "legend": "Datos de Contacto",
      "style": "border:1px solid #17a2b8; padding:10px; background:#f3f9fa;",
      "fields": [
        { "name": "paises_visitados", "label": "Países Visitados (Select2)", "type": "select2", "multiple": true, "placeholder": "Seleccione países", "data": { "tabla": "Pais", "campo": "PaiDes", "filtro": "1=1" } },
        { "name": "ciudad_2", "label": "Ciudad (SelectData)", "type": "selectdata", "data": { "tabla": "Comuna", "campo": "ComDes", "filtro": "1=1" } }
      ]
    },
    {
      "name": "detalle_productos",
      "legend": "Detalle de Productos",
      "style": "border:1px solid #dc3545; padding:10px; background:#fff5f5;",
      "fields": [
        { "name": "items", "label": "Listado de Items", "type": "datatable", "columns": [ { "name": "id_producto", "label": "ID", "type": "text" }, { "name": "descripcion", "label": "Descripción", "type": "text" }, { "name": "cantidad", "label": "Cant.", "type": "number" }, { "name": "precio_unitario", "label": "Precio", "type": "number" }, { "name": "subtotal", "label": "Subtotal", "type": "number", "readonly": true, "data-formula": "cantidad * precio_unitario" } ] }
      ]
    },
    {
      "name": "todos_los_controles",
      "legend": "Galería Completa de Controles",
      "style": "border:1px solid #ffc107; padding:10px; background:#fffcf2;",
      "fields": [
        { "name": "descripcion_larga", "label": "Textarea", "type": "textarea", "placeholder": "Escriba un texto largo aquí...", "rows": 3 },
        { "name": "opcion_simple", "label": "Select (Simple)", "type": "select", "options": [ { "value": "1", "label": "Opción A" }, { "value": "2", "label": "Opción B" } ] }
      ]
    },
    {
      "name": "informacion_adicional",
      "legend": "Información Adicional",
      "style": "border:1px solid #28a745; padding:10px; background:#f5fff5;",
      "fields": [
        { "name": "genero", "label": "Género", "type": "radio", "required": true, "layout": "horizontal", "options": [ { "value": "masculino", "label": "Masculino" }, { "value": "femenino", "label": "Femenino" } ] }
      ]
    },
    {
        "name": "resumen_envio",
        "legend": "Resumen y Envío",
        "style": "border:1px solid #6c757d; padding:10px; background:#f8f9fa;",
        "fields": [
          { "name": "comentarios_finales", "label": "Comentarios Finales", "type": "textarea", "placeholder": "Añada cualquier comentario adicional aquí...", "rows": 3 }
        ]
    }
  ]
}

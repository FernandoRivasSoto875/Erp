{
  "version": "1.2.0 - Layout con Pestañas",
  "titulo": "Formulario de Ejemplo con Pestañas",
  "descripcion": "Demostración del nuevo motor de layout con bloques y pestañas.",
  "fieldsets": {
    "datos_personales": {
      "titulo": "Datos Personales",
      "campos": [
        {
          "nombre": "nombre_completo",
          "etiqueta": "Nombre Completo",
          "tipo": "text",
          "placeholder": "Ingrese su nombre",
          "atributos": { "required": true }
        },
        {
          "nombre": "email",
          "etiqueta": "Correo Electrónico",
          "tipo": "email",
          "placeholder": "ejemplo@dominio.com"
        }
      ]
    },
    "datos_contacto": {
      "titulo": "Información de Contacto",
      "campos": [
        {
          "nombre": "telefono",
          "etiqueta": "Teléfono",
          "tipo": "text",
          "placeholder": "+56 9 1234 5678"
        },
        {
          "nombre": "direccion",
          "etiqueta": "Dirección",
          "tipo": "textarea",
          "placeholder": "Calle, número, comuna, ciudad"
        }
      ]
    },
    "datos_empresa": {
      "titulo": "Datos de la Empresa",
      "campos": [
        {
          "nombre": "nombre_empresa",
          "etiqueta": "Nombre de la Empresa",
          "tipo": "text"
        },
        {
          "nombre": "cargo",
          "etiqueta": "Cargo",
          "tipo": "text"
        }
      ]
    },
    "intereses": {
      "titulo": "Áreas de Interés",
      "campos": [
        {
          "nombre": "area_interes",
          "etiqueta": "Seleccione un área",
          "tipo": "select",
          "opciones": {
            "tec": "Tecnología",
            "ventas": "Ventas",
            "mkt": "Marketing"
          }
        }
      ]
    },
    "comentarios": {
      "titulo": "Comentarios Adicionales",
      "campos": [
        {
          "nombre": "comentarios",
          "etiqueta": "Comentarios",
          "tipo": "textarea"
        }
      ]
    },
    "header_info": {
      "titulo": "Información General del Formulario",
      "campos": [
        {
          "nombre": "tipo_solicitud",
          "etiqueta": "Tipo de Solicitud",
          "tipo": "text",
          "valor_predeterminado": "Contacto General",
          "atributos": { "readonly": true }
        }
      ]
    },
    "footer_legal": {
      "titulo": "Términos y Condiciones",
      "campos": [
        {
          "nombre": "aceptar_terminos",
          "etiqueta": "Acepto los términos y condiciones",
          "tipo": "checkbox",
          "opciones": { "si": "" }
        }
      ]
    }
  },
  "layout": {
    "header": {
      "type": "header",
      "rows": [
        {
          "columns": [
            { "width": "12", "fieldset": "header_info" }
          ]
        }
      ]
    },
    "main": {
      "type": "tabs",
      "tabs": [
        {
          "title": "Información Principal",
          "rows": [
            {
              "columns": [
                { "width": "6", "fieldset": "datos_personales" },
                { "width": "6", "fieldset": "datos_contacto" }
              ]
            }
          ]
        },
        {
          "title": "Detalles Laborales",
          "rows": [
            {
              "columns": [
                { "width": "12", "fieldset": "datos_empresa" }
              ]
            }
          ]
        },
        {
          "title": "Otros",
          "rows": [
            {
              "columns": [
                { "width": "6", "fieldset": "intereses" },
                { "width": "6", "fieldset": "comentarios" }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "rows": [
        {
          "columns": [
            { "width": "12", "fieldset": "footer_legal" }
          ]
        }
      ]
    }
  }
}


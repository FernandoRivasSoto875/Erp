{
  "parametros": {
    "titulo": "Formulario Genérico 2 - Layout Dinámico",
    "CssDefault": "formulariodinamico-neumorphism.css",
    "tituloimagen": "https://cdn.pixabay.com/photo/2017/05/31/16/39/windows-2360920_1280.png",
    "comentario": "Demostración del nuevo motor de layout con cabecera, pestañas y bloques.",
    "pie": "Gracias por usar nuestro sistema.",
    "fecha_creacion": "2024-08-06",
    "cantidadMaximaAdjuntos": 5,
    "limpiar": true,
    "destinatario": "fernandorivassoto@gmail.com",
    "remitente": "gestion@saludenterreno.cl",
    "subject": "Nuevo mensaje desde el formulario de contacto",
    "estilo": "padding:20px; background:#e8f0fe;",
    "mailDe": "Intranet@SaludEnterreno.cl",
    "mailPara": "fernandorivassoto@gmail.com",
    "mailCc": "copia@example.com",
    "mailCco": "copiaoculta@example.com",
    "tipoformatoenvio": "htmlc,pdf,html,xls,json,cvs,xlsx,doc,xml",
    "mensajes": {
      "exito": "¡Formulario enviado correctamente!",
      "error": "Ocurrió un error al procesar el formulario.",
      "advertencia": "Por favor, revisa los campos resaltados."
    },
    "validaciones": {
      "email": {
        "regex": "^[\\w\\.-]+@[\\w\\.-]+\\.\\w{2,}$",
        "mensaje": "El correo no es válido."
      },
      "telefono": {
        "regex": "^\\+56\\d{9}$",
        "mensaje": "El teléfono debe tener formato +569XXXXXXXX."
      }
    },
    "botones": [
      { "texto": "Guardar", "accion": "submit", "clase": "btn-success" },
      { "texto": "Limpiar", "accion": "reset", "clase": "btn-secondary" }
    ],
    "post_envio": {
      "redireccion": "",
      "mostrar_resumen": true,
      "limpiar_sesion": true
    },
    "adjuntos": {
      "tipos_permitidos": ["image/jpeg", "image/png", "application/pdf"],
      "tamano_maximo_mb": 5
    },
    "notificaciones": {
      "enviar_correo": true,
      "guardar_bd": false,
      "mostrar_modal": true
    }
  },
  "layout": {
    "header": {
      "type": "header",
      "fieldsets": ["datos_personales"]
    },
    "main": {
      "type": "tabs",
      "tabs": [
        {
          "title": "Preferencias y Detalles",
          "rows": [
            { "cols": [ { "size": 6, "fieldsets": ["preferencias"] }, { "size": 6, "fieldsets": ["detalle_productos"] } ] }
          ]
        },
        {
          "title": "Todos los Controles",
          "rows": [
            { "cols": [ { "size": 12, "fieldsets": ["todos_los_controles"] } ] }
          ]
        },
        {
          "title": "Pestaña Vacía",
           "rows": [
            { "cols": [ { "size": 12, "content": "<h3>Contenido de la tercera pestaña</h3><p>Aquí se puede agregar más contenido o fieldsets.</p>" } ] }
          ]
        }
      ]
    }
  },
  "fieldsets": [
    {
      "name": "datos_personales",
      "legend": "Datos Personales (Cabecera)",
      "style": "border:1px solid #007BFF; padding:10px; background:#f9f9f9;",
      "fields": [
        { "name": "nombre", "label": "Nombre", "type": "text", "placeholder": "Ingrese su nombre completo", "required": true, "labelPosition": "top-left" },
        { "name": "ComId", "label": "Código", "type": "text", "placeholder": "Ingrese código", "labelPosition": "left" },
        { 
          "name": "descripcion_comuna", 
          "label": "Comuna", 
          "type": "text", 
          "placeholder": "Descripción de la comuna aparecerá aquí", 
          "labelPosition": "left", 
          "readonly": true, 
          "data-formula": { 
            "type": "lookup", 
            "source": { "table": "Comuna", "field": "ComDes" }, 
            "where": "ComId = {ComId}" 
          }
        },
        { "name": "email", "label": "Correo", "type": "email", "placeholder": "ejemplo@correo.com", "required": true, "labelPosition": "top" }
      ]
    },
    {
      "name": "preferencias",
      "legend": "Preferencias y Otros (Columna 1)",
      "style": "border:1px solid #28a745; padding:10px; background:#f5fff5;",
      "fields": [
        { 
          "name": "genero", 
          "label": "Género", 
          "type": "radio", 
          "required": true, 
          "layout": "horizontal", 
          "options": [ { "value": "masculino", "label": "Masculino" }, { "value": "femenino", "label": "Femenino" } ] 
        },
        { 
          "name": "paises_visitados", 
          "label": "Países Visitados (Select2)", 
          "type": "select2", 
          "multiple": true,
          "placeholder": "Seleccione países",
          "labelPosition": "top", 
          "data": { "tabla": "Pais", "campo": "PaiDes", "filtro": "1=1" }
        },
        { "name": "ciudad_2", "label": "Ciudad (SelectData)", "type": "selectdata", "labelPosition": "left", "data": { "tabla": "Comuna", "campo": "ComDes", "filtro": "1=1" } }
      ]
    },
    {
      "name": "detalle_productos",
      "legend": "Detalle de Productos (Columna 2)",
      "style": "border:1px solid #dc3545; padding:10px; background:#fff5f5;",
      "fields": [
        {
          "name": "items",
          "label": "Listado de Items",
          "type": "datatable",
          "labelPosition": "top",
          "columns": [
            { "name": "id_producto", "label": "ID Producto", "type": "text" },
            { "name": "descripcion", "label": "Descripción", "type": "text" },
            { "name": "cantidad", "label": "Cantidad", "type": "number" },
            { "name": "precio_unitario", "label": "Precio Unit.", "type": "number" },
            { "name": "subtotal", "label": "Subtotal", "type": "number", "readonly": true, "data-formula": "cantidad * precio_unitario" }
          ],
          "value": [
            { "id_producto": "PROD-001", "descripcion": "Mouse", "cantidad": 2, "precio_unitario": 15000 },
            { "id_producto": "PROD-002", "descripcion": "Teclado", "cantidad": 1, "precio_unitario": 55000 }
          ]
        }
      ]
    },
    {
      "name": "todos_los_controles",
      "legend": "Galería Completa de Controles",
      "style": "border:1px solid #ffc107; padding:10px; background:#fffcf2;",
      "fields": [
        { "name": "descripcion_larga", "label": "Textarea", "type": "textarea", "placeholder": "Escriba un texto largo aquí...", "rows": 3 },
        { "name": "opcion_simple", "label": "Select (Simple)", "type": "select", "options": [ { "value": "1", "label": "Opción A" }, { "value": "2", "label": "Opción B" } ] },
        { "name": "intereses_multiples", "label": "Intereses (Checkbox)", "type": "checkbox", "options": [ { "value": "deportes", "label": "Deportes" }, { "value": "musica", "label": "Música" }, { "value": "viajes", "label": "Viajes" } ] },
        { "name": "documento_unico", "label": "Archivo (Único)", "type": "file" },
        { "name": "documentos_multiples", "label": "Archivos (Múltiples)", "type": "file", "multiple": true },
        { "name": "clave_secreta", "label": "Contraseña", "type": "password", "placeholder": "Contraseña segura" },
        { "name": "nivel_satisfaccion", "label": "Nivel de Satisfacción", "type": "range", "min": 0, "max": 10, "value": 5 },
        { "name": "telefono_contacto", "label": "Teléfono", "type": "tel", "placeholder": "+56912345678" },
        { "name": "fecha_evento", "label": "Fecha", "type": "date" },
        { "name": "fecha_hora_evento", "label": "Fecha y Hora", "type": "datetime-local" },
        { "name": "mes_facturacion", "label": "Mes de Facturación", "type": "month" },
        { "name": "semana_reunion", "label": "Semana de Reunión", "type": "week" },
        { "name": "hora_reunion", "label": "Hora de Reunión", "type": "time" },
        { "name": "campo_oculto", "type": "hidden", "value": "informacion_secreta" }
      ]
    }
  ]
}

{
  "field_types": {
    "text":         { "html": "input",   "subtype": "text",             "icon": "fas fa-font" },
    "textarea":     { "html": "textarea",                               "icon": "fas fa-align-left" },
    "number":       { "html": "input",   "subtype": "number",           "icon": "fas fa-hashtag" },
    "integer":      { "html": "input",   "subtype": "number", "step": 1,        "icon": "fas fa-hashtag" },
    "decimal":      { "html": "input",   "subtype": "number", "step": "0.01",   "icon": "fas fa-divide" },
    "currency":     { "html": "input",   "subtype": "number", "step": "0.01", "format": "currency", "icon": "fas fa-dollar-sign" },
    "percent":      { "html": "input",   "subtype": "number", "step": "0.01", "format": "percent",  "icon": "fas fa-percent" },
    "date":         { "html": "input",   "subtype": "date",             "icon": "fas fa-calendar" },
    "datetime":     { "html": "input",   "subtype": "datetime-local",   "icon": "fas fa-calendar-day" },
    "time":         { "html": "input",   "subtype": "time",             "icon": "fas fa-clock" },
    "email":        { "html": "input",   "subtype": "email",            "icon": "fas fa-envelope" },
    "tel":          { "html": "input",   "subtype": "tel",              "icon": "fas fa-phone" },
    "url":          { "html": "input",   "subtype": "url",              "icon": "fas fa-link" },
    "password":     { "html": "input",   "subtype": "password",         "icon": "fas fa-key" },
    "checkbox":     { "html": "input",   "subtype": "checkbox",         "icon": "far fa-check-square" },
    "switch":       { "html": "input",   "subtype": "checkbox",         "icon": "fas fa-toggle-on" },
    "radio":        { "html": "input",   "subtype": "radio",            "icon": "far fa-dot-circle" },
    "range":        { "html": "input",   "subtype": "range",            "icon": "fas fa-sliders-h" },
    "color":        { "html": "input",   "subtype": "color",            "icon": "fas fa-palette" },
    "hidden":       { "html": "input",   "subtype": "hidden",           "icon": "fas fa-eye-slash" },

    "select":       { "html": "select",  "multiple": false,             "icon": "fas fa-list" },
    "multiselect":  { "html": "select",  "multiple": true,              "icon": "fas fa-tasks" },

    "select2":             { "html": "select", "component": "select2", "multiple": false, "icon": "fas fa-list-ul" },
    "select2_multiselect": { "html": "select", "component": "select2", "multiple": true,  "icon": "fas fa-tasks" },
    "select_remote":       { "html": "select", "component": "select2", "remote": true, "multiple": false, "icon": "fas fa-search" },
    "select2_remote":      { "html": "select", "component": "select2", "remote": true, "multiple": false, "icon": "fas fa-search" },

    "autocomplete":        { "html": "custom", "component": "autocomplete",              "icon": "fas fa-ellipsis-h" },
    "autocomplete_remote": { "html": "custom", "component": "autocomplete", "remote": true, "icon": "fas fa-ellipsis-h" },
    "lookup":       { "html": "custom", "component": "lookup",          "icon": "fas fa-search-plus" },
    "chips":        { "html": "custom", "component": "chips",           "icon": "fas fa-tag" },
    "tags":         { "html": "custom", "component": "chips",           "icon": "fas fa-tags" },

    "file":         { "html": "input",   "subtype": "file",             "icon": "fas fa-file-upload" },
    "multifile":    { "html": "input",   "subtype": "file", "multiple": true, "icon": "fas fa-file-upload" },
    "image":        { "html": "input",   "subtype": "file", "accept": "image/*", "icon": "far fa-image" },

    "html":         { "html": "custom", "component": "html",            "icon": "fas fa-code" },
    "markdown":     { "html": "custom", "component": "markdown",        "icon": "fab fa-markdown" },
    "editor":       { "html": "custom", "component": "editor", "variant": "quill", "icon": "fas fa-pen" },
    "code":         { "html": "custom", "component": "code", "language": "javascript", "icon": "fas fa-code" },
    "jsoneditor":   { "html": "custom", "component": "jsoneditor",      "icon": "fas fa-brackets-curly" },

    "table":        { "html": "custom", "component": "table",           "icon": "fas fa-table" },
    "datatable":    { "html": "custom", "component": "datatable", "columns": [], "dataSource": "", "serverSide": false, "icon": "fas fa-table" },

    "grid":         { "html": "custom", "component": "grid",            "icon": "fas fa-border-all" },
    "repeater":     { "html": "custom", "component": "repeater", "itemSchema": {}, "icon": "far fa-clone" },

    "map":          { "html": "custom", "component": "map",             "icon": "fas fa-map-marked-alt" },
    "geolocation":  { "html": "custom", "component": "geolocation",     "icon": "fas fa-location-dot" },
    "signature":    { "html": "custom", "component": "signature",       "icon": "fas fa-signature" },
    "qrcode":       { "html": "custom", "component": "qrcode",          "icon": "fas fa-qrcode" },
    "barcode":      { "html": "custom", "component": "barcode",         "icon": "fas fa-barcode" },
    "rating":       { "html": "custom", "component": "rating", "max": 5, "icon": "fas fa-star" },
    "captcha":      { "html": "custom", "component": "captcha",         "icon": "fas fa-robot" },

    "tree":         { "html": "custom", "component": "tree",            "icon": "fas fa-sitemap" },
    "treeselect":   { "html": "custom", "component": "treeselect",      "icon": "fas fa-tree" },

    "badge":        { "html": "custom", "component": "badge",           "icon": "fas fa-award" },
    "button":       { "html": "button", "variant": "primary",           "icon": "fas fa-square" }
  },
  "fieldset_types": {
    "group":      { "layout": "stack",      "icon": "fas fa-layer-group" },
    "card":       { "layout": "stack",      "icon": "far fa-id-card" },
    "panel":      { "layout": "stack",      "icon": "far fa-window-maximize" },
    "section":    { "layout": "stack",      "icon": "far fa-object-group" },
    "row":        { "layout": "row",        "icon": "fas fa-grip-horizontal" },
    "column":     { "layout": "column",     "icon": "fas fa-grip-vertical" },
    "tabs":       { "layout": "tabs",       "icon": "far fa-folder" },
    "accordion":  { "layout": "accordion",  "icon": "fas fa-bars" },
    "stepper":    { "layout": "steps",      "icon": "fas fa-stream" },
    "wizard":     { "layout": "steps",      "icon": "fas fa-magic" },
    "divider":    { "layout": "separator",  "icon": "fas fa-minus" }
  }
}